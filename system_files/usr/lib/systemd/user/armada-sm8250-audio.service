[Unit]
Description=Create SM8250 RetroidPocket PipeWire speaker sink
ConditionPathExists=/proc/asound/cards
After=pipewire.service wireplumber.service pipewire-pulse.service
Wants=pipewire.service wireplumber.service

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 2
ExecStart=/bin/bash -c '/etc/armada/sm8250-audio-init boot || true'
RemainAfterExit=yes

[Install]
WantedBy=default.target
