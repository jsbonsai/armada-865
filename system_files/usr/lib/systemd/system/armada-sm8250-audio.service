[Unit]
Description=Apply SM8250 speaker mixer routing before user session audio
ConditionPathExists=/proc/asound/cards
After=sound.target
Before=graphical.target sddm.service
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/libexec/armada/sm8250-audio-init mixers
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
