#!/bin/bash
# Flash Retroid's fixed U-Boot (github.com/RetroidPocket/u-boot rp-v1.0.1) to
# the UFS `loader` partition, from inside a booted Armada — no PC/fastboot needed.
#
# Why: Retroid's Android OTA shipped a faulty loader build for the Mini V2 whose
# simple-framebuffer geometry doesn't match the 1080x1240 panel, so the U-Boot
# boot menu AND GRUB (which inherits U-Boot's EFI GOP) render garbled. rp-v1.0.1
# carries the corrected per-device device trees. The stock ABL (and its fastboot
# mode, Vol- + Power) is untouched, so a bad flash is always recoverable with:
#   fastboot flash loader <backup-or-release-image>
set -euo pipefail

RELEASE_URL="https://github.com/RetroidPocket/u-boot/releases/download/rp-v1.0.1"
IMG_DIR_DEFAULT="/boot/efi/retroid_loader"
BACKUP_DIR="/var/lib/armada"
IMG_SIZE=647168

usage() {
    cat <<EOF
Usage: armada-flash-loader [--yes] [--device rp5|flip2|rpmini|rpminiv2] [--from DIR]
Flashes the matching rp-v1.0.1 U-Boot image to the 'loader' partition.
Images are read from ${IMG_DIR_DEFAULT} (staged on the SD's boot partition),
or downloaded from ${RELEASE_URL} if missing. sha256-verified either way.
EOF
    exit "${1:-0}"
}

# Pinned sha256 of the rp-v1.0.1 assets (verified 2026-07-25).
img_sha() {
    case "$1" in
        rp5)      echo af2c337f7f9576833581c99a797a05c5a9f3d5afb5f5ef8f8e8404e27ff0b088 ;;
        flip2)    echo 5055dd574733da49606a27d5a1a4831326ea078a13ed9e5b677146ecc1a3871d ;;
        rpmini)   echo ee837fa8b9c9e2093414cd87d08f79e3fea60340009409403eee6e4404cda229 ;;
        rpminiv2) echo 7f110ac7c8e6a98b7507418f3ffd7865ac6395dfc94589492c1d99e114b6b8f8 ;;
        *) return 1 ;;
    esac
}

YES=0 DEVICE="" IMG_DIR="${IMG_DIR_DEFAULT}"
while [ $# -gt 0 ]; do
    case "$1" in
        --yes) YES=1 ;;
        --device) DEVICE="${2:?}"; shift ;;
        --from) IMG_DIR="${2:?}"; shift ;;
        -h|--help) usage ;;
        *) echo "unknown argument: $1" >&2; usage 1 ;;
    esac
    shift
done

[ "$(id -u)" = 0 ] || { echo "run as root (sudo)" >&2; exit 1; }

if [ -z "${DEVICE}" ]; then
    model=$(tr -d '\0' < /proc/device-tree/model 2>/dev/null || true)
    case "${model}" in
        *"Mini V2"*)  DEVICE=rpminiv2 ;;
        *Mini*)       DEVICE=rpmini ;;
        *Flip*)       DEVICE=flip2 ;;
        *"Pocket 5"*) DEVICE=rp5 ;;
        *) echo "unrecognized device model '${model}' — pass --device explicitly" >&2; exit 1 ;;
    esac
fi
SHA=$(img_sha "${DEVICE}") || { echo "unknown device '${DEVICE}'" >&2; exit 1; }
IMG_NAME="u-boot-sm8250-retroidpocket-${DEVICE}.img"

# Loader partition discovery. RP5 exposes a single 'loader'; the Mini V2 has
# A/B slots 'loader_a'+'loader_b' (flash BOTH — fastboot's 'loader' alias only
# writes the active slot, so a later slot switch would resurrect the bad build).
# Some UFS boot LUNs aren't partition-scanned by the kernel at boot (no
# /dev/sdXN nodes, hit on the Mini V2) — partx -a materializes them.
PARTS=()
for name in loader loader_a loader_b; do
    [ -b "/dev/disk/by-partlabel/${name}" ] && PARTS+=("$(readlink -f "/dev/disk/by-partlabel/${name}")")
done
if [ "${#PARTS[@]}" -eq 0 ]; then
    for disk in /dev/sd?; do
        if partx --show "${disk}" 2>/dev/null | awk '{print $NF}' | grep -qx 'loader\(_[ab]\)\?'; then
            partx -a "${disk}" 2>/dev/null || true
            udevadm settle 2>/dev/null || true
            while read -r nr pname; do
                [ -b "${disk}${nr}" ] && PARTS+=("${disk}${nr}")
            done < <(partx --show "${disk}" | awk '$NF ~ /^loader(_[ab])?$/ {print $1, $NF}')
        fi
    done
fi
[ "${#PARTS[@]}" -gt 0 ] || { echo "no loader/loader_a/loader_b partition found — is this a Retroid SM8250 device?" >&2; exit 1; }
for p in "${PARTS[@]}"; do
    sz=$(blockdev --getsize64 "$p")
    [ "${sz}" -ge "${IMG_SIZE}" ] || { echo "loader partition $p (${sz}B) smaller than image (${IMG_SIZE}B)?!" >&2; exit 1; }
done

WORK=$(mktemp -d)
trap 'rm -rf "${WORK}"' EXIT
IMG="${IMG_DIR}/${IMG_NAME}"
if [ ! -f "${IMG}" ]; then
    echo "${IMG_NAME} not in ${IMG_DIR}; downloading from ${RELEASE_URL} ..."
    curl -fsSL -o "${WORK}/${IMG_NAME}" "${RELEASE_URL}/${IMG_NAME}"
    IMG="${WORK}/${IMG_NAME}"
fi
echo "${SHA}  ${IMG}" | sha256sum -c - >/dev/null || { echo "sha256 mismatch on ${IMG} — refusing to flash" >&2; exit 1; }

TS=$(date +%Y%m%d-%H%M%S)
mkdir -p "${BACKUP_DIR}"
# Backups land on internal AND the SD ESP — the SD survives any internal mishap.
SD_BACKUPS=/boot/efi/loader-backups
mkdir -p "${SD_BACKUPS}" 2>/dev/null || SD_BACKUPS=""
for p in "${PARTS[@]}"; do
    b="${BACKUP_DIR}/loader-backup-$(basename "$p")-${TS}.img"
    dd if="$p" of="$b" bs=4M status=none
    [ -n "${SD_BACKUPS}" ] && cp "$b" "${SD_BACKUPS}/" 2>/dev/null || true
    echo "backed up $p -> $b$([ -n "${SD_BACKUPS}" ] && echo ' (+ SD copy)')"
done
sync

echo "About to flash ${IMG_NAME} (rp-v1.0.1) to: ${PARTS[*]} (${DEVICE})."
if [ "${YES}" != 1 ]; then
    read -r -p "Proceed? [y/N] " a
    case "${a}" in y|Y|yes|YES) ;; *) echo "aborted"; exit 1 ;; esac
fi

for p in "${PARTS[@]}"; do
    dd if="${IMG}" of="$p" bs=4M conv=fsync status=none
    # Read back exactly the image span and verify.
    READBACK_SHA=$(dd if="$p" bs="${IMG_SIZE}" count=1 status=none | sha256sum | cut -d' ' -f1)
    [ "${READBACK_SHA}" = "${SHA}" ] || {
        echo "VERIFY FAILED on $p — restore with: dd if=${BACKUP_DIR}/loader-backup-$(basename "$p")-${TS}.img of=$p bs=4M conv=fsync" >&2
        echo "or from fastboot (Vol- + Power): fastboot flash loader <backup>" >&2
        exit 1
    }
    echo "OK: $p flashed and verified."
done
sync
echo "Done. Boot menu + GRUB should render correctly on next boot."
