[Desktop Entry]
Type=Application
Name=Armada Installer
Comment=Install Armada alongside Android on the device's internal storage, or remove an existing install
# SM8250 fork: upstream's installer partitions for the qcom-abl /KERNEL boot
# chain — wrong for these GRUB/EFI devices. Point the same entry at ours.
Exec=/usr/libexec/armada/armada-865-install-internal gui
TryExec=/run/armada/installable
Icon=drive-harddisk
Terminal=false
Categories=System;Settings;
Keywords=install;internal;armada;
