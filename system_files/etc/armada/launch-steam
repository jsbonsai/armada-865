#!/usr/bin/bash
set -euo pipefail

steam_args=()
is_desktop=0
if [[ ${1:-} == "--desktop" ]]; then
    shift
    steam_args=(-steamdeck)
    is_desktop=1
fi

steam_root="${STEAM_ROOT:-${HOME}/.local/share/Steam}"
steam_arm_dir="${steam_root}/steamrtarm64"
steam_arm="${steam_arm_dir}/steam"
steam_shim_dir="${steam_root}/lib/aarch64-linux-gnu"
steam_runtime_bin="${steam_root}/steam-runtime-steamrt-arm64/bin"

if [[ ! -x "${steam_arm}" ]]; then
    echo "ERROR: native ARM Steam is missing or not executable: ${steam_arm}" >&2
    exit 127
fi

steam_ld_path="${steam_arm_dir}"
if [[ -d "${steam_shim_dir}" ]]; then
    steam_ld_path="${steam_ld_path}:${steam_shim_dir}"
fi
export LD_LIBRARY_PATH="${steam_ld_path}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
if [[ -d "${steam_runtime_bin}" ]]; then
    export PATH="${steam_runtime_bin}:${PATH}"
fi

touch "${steam_root}/.cef-enable-remote-debugging"
if [[ -x /etc/armada/sm8250-audio-init ]] && grep -q RetroidPocket /proc/asound/cards 2>/dev/null; then
    unset STEAM_DISABLE_AUDIO_DEVICE_SWITCHING
    export PULSE_SINK=alsa_sink.sm8250_speaker
    export PULSE_DEFAULT_SINK=alsa_sink.sm8250_speaker
    /etc/armada/sm8250-audio-init boot || true
fi
# FEX Multiblock (measured 84s -> 58s cold launch on Flip 2) is now set in the
# Default FEX profile (/usr/share/armada/fex-profiles.json), applied per-game by
# armada-proton-wrapper. A global FEX_MULTIBLOCK env export here would OVERRIDE
# every per-game profile (making Compatible/per-game unreliable) and can poison
# FEX code-cache code maps — so it is intentionally NOT exported.
/usr/libexec/armada/powerbuttond >/dev/null 2>&1 &
if [[ "${is_desktop}" == 0 ]]; then
    # One-time gamepadui scale default (no-op unless the device profile sets
    # ARMADA_STEAM_UI_SCALE — currently only the Mini V2, whose near-square
    # panel maxes out Steam's auto interface scale). Gamepadui session only:
    # in desktop Big Picture the display identity differs, and forcing a
    # factor there would write the wrong config.vdf entry.
    /usr/libexec/armada/steam-ui-scale >/dev/null 2>&1 &
fi
cd "${steam_arm_dir}"
exec "${steam_arm}" \
    "${steam_args[@]}" \
    "$@"
