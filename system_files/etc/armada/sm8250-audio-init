#!/usr/bin/env bash
# Bring up SM8250 RetroidPocket speaker path on hw:0,1 (MultiMedia2 / WSA speakers).
# Usage: sm8250-audio-init [mixers|sink|refresh|all]   (default: all)
set -euo pipefail

mode="${1:-all}"

card=""
if [[ -r /proc/asound/cards ]]; then
    card=$(awk '/RetroidPocket/ { print $1; exit }' /proc/asound/cards)
fi
[[ -n "$card" ]] || exit 0

SINK_NAME=alsa_sink.sm8250_speaker
DEVICE="plughw:${card},1"

amixer_set() {
    amixer -c "$card" cset "name=$1" "$2" >/dev/null 2>&1 || true
}

mixer_is_on() {
    amixer -c "$card" cget "name=$1" 2>/dev/null | grep -q ': values=on'
}

apply_speaker_mixers() {
    # HiFi EnableSequence (UCM HiFi-RP.conf)
    amixer_set "RX_CODEC_DMA_RX_0 Audio Mixer MultiMedia1" 1
    amixer_set "MultiMedia3 Mixer TX_CODEC_DMA_TX_3" 1
    # BootSequence volumes (RetroidPocket.conf)
    amixer_set "WSA_RX0 Digital Volume" 120
    amixer_set "WSA_RX1 Digital Volume" 120
    amixer_set "SpkrLeft PA Volume" 12
    amixer_set "SpkrRight PA Volume" 12
    # wsa-macro + wsa881x SpeakerEnableSeq
    amixer_set "WSA RX0 MUX" "AIF1_PB"
    amixer_set "WSA RX1 MUX" "AIF1_PB"
    amixer_set "WSA_RX0 INP0" "RX0"
    amixer_set "WSA_RX1 INP0" "RX1"
    amixer_set "SpkrLeft COMP Switch" 1
    amixer_set "SpkrLeft BOOST Switch" 1
    amixer_set "SpkrLeft DAC Switch" 1
    amixer_set "SpkrLeft VISENSE Switch" 0
    amixer_set "SpkrRight COMP Switch" 1
    amixer_set "SpkrRight BOOST Switch" 1
    amixer_set "SpkrRight DAC Switch" 1
    amixer_set "SpkrRight VISENSE Switch" 0
    ensure_speaker_dma_path
}

ensure_speaker_dma_path() {
    local i
    for i in 1 2 3; do
        amixer_set "MultiMedia2 Mixer WSA_CODEC_DMA_TX_0" 1
        amixer_set "WSA_CODEC_DMA_RX_0 Audio Mixer MultiMedia2" 1
        if mixer_is_on "WSA_CODEC_DMA_RX_0 Audio Mixer MultiMedia2"; then
            return 0
        fi
        sleep 0.2
    done
    return 1
}

refresh_dma_path_active() {
    amixer_set "WSA_CODEC_DMA_RX_0 Audio Mixer MultiMedia2" 1
    amixer_set "MultiMedia2 Mixer WSA_CODEC_DMA_TX_0" 1
}

refresh_active_path() {
    apply_speaker_mixers
    refresh_dma_path_active
}

speaker_path_ready() {
    apply_speaker_mixers
}

setup_user_sink() {
    local user=$1
    local uid
    uid=$(id -u "$user")
    [[ -d "/run/user/${uid}" ]] || return 0

    speaker_path_ready || return 0

    runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/${uid}" DEVICE="$DEVICE" SINK_NAME="$SINK_NAME" \
        bash -c '
            set -uo pipefail

            idx=$(pactl list modules short 2>/dev/null | awk "/sink_name=${SINK_NAME}/ {print \$1; exit}")
            [[ -n "$idx" ]] && pactl unload-module "$idx" 2>/dev/null || true

            pactl load-module module-alsa-sink \
                sink_name="$SINK_NAME" \
                device="$DEVICE" \
                format=s16le channels=2 rate=48000 \
                sink_properties="device.description=RetroidPocket Speakers,device.form_factor=speaker" \
                >/dev/null 2>&1 || true

            if pactl list sinks short 2>/dev/null | grep -q "$SINK_NAME"; then
                pactl set-default-sink "$SINK_NAME" 2>/dev/null || true
                pactl set-sink-mute "$SINK_NAME" 0 2>/dev/null || true
                pactl set-sink-volume "$SINK_NAME" 35% 2>/dev/null || true
                id=$(wpctl status 2>/dev/null | awk "/RetroidPocket Speakers/{print \$2; exit}" | tr -d ".")
                [[ -n "$id" ]] && wpctl set-default "$id" 2>/dev/null || true
                pactl list sink-inputs short 2>/dev/null | while read -r sid _; do
                    [[ -n "$sid" ]] && pactl move-sink-input "$sid" "$SINK_NAME" 2>/dev/null || true
                done
            fi
        '

    refresh_dma_path_active
}

case "$mode" in
    mixers)
        apply_speaker_mixers
        ;;
    sink)
        for user in armada; do
            if id "$user" &>/dev/null; then
                setup_user_sink "$user"
            fi
        done
        ;;
    refresh)
        refresh_active_path
        ;;
    all)
        apply_speaker_mixers
        for user in armada; do
            if id "$user" &>/dev/null; then
                setup_user_sink "$user"
            fi
        done
        ;;
    *)
        echo "Usage: $0 [mixers|sink|all]" >&2
        exit 1
        ;;
esac
